# Required: API key issued by your provider (OpenAI, or a third-party provider)
OPENAI_API_KEY=your_openai_api_key

# Optional: OpenAI-compatible base URL of a third-party provider (relay or
# token plan). Setting this switches the Agents SDK to /v1/chat/completions and
# turns off OpenAI tracing. See agents_config.py for the details.
#OPENAI_BASE_URL=https://your-provider.example.com/v1

# Optional: overrides for the two behaviours that OPENAI_BASE_URL triggers.
#OPENAI_AGENTS_CHAT_API=1
#OPENAI_AGENTS_DISABLE_TRACING=1

# Optional: run every agent on this model instead of the model the book picked
# for each example (and instead of the SDK's own default for the examples that
# pick none). Set it to a model your provider serves.
#AGENT_MODEL=gpt-4o

# Optional: model for the image examples (chapter_07/07, chapter_07/08,
# chapter_08/02_app.py and bonus_projects/). Defaults to dall-e-3. IMAGE_SIZE
# overrides the size they ask for, because the book uses gpt-image-1 sizes.
#IMAGE_MODEL=dall-e-3
#IMAGE_SIZE=1024x1024

# Optional: model for the direct vision call in chapter_07/08. Falls back to
# AGENT_MODEL, then to the model the book used.
#VISION_MODEL=gpt-4o

# Optional: embedding model for chapter_06/document_query_chromadb.py and
# chapter_06/document_visualizing_embeddings.py. Does not fall back to
# AGENT_MODEL - a chat model cannot produce embeddings.
#EMBEDDING_MODEL=text-embedding-ada-002

# Optional: temperature for the examples that set one (chapter_02/02). Set it
# to 1 if your model is a reasoning-style model that rejects any other value.
#AGENT_TEMPERATURE=1

# Optional: structured-output fallback for providers whose models reject the
# SDK's native JSON Schema response_format. Unset keeps that native behaviour,
# which is the default. deepseek_json sends response_format
# {"type":"json_object"}, which guarantees JSON syntax but not the schema;
# minimax_function forces a synthetic emit_typed_output function whose
# parameters are the declared output schema.
#AGENT_STRUCTURED_OUTPUT_MODE=deepseek_json
#AGENT_STRUCTURED_OUTPUT_MODE=minimax_function
#
# The mode is endpoint-wide: it is chosen for the provider behind
# OPENAI_BASE_URL and is never inferred from the model id, because aliases and
# relays are not reliable provider identifiers. Both modes need the Chat
# Completions route, so setting one while OPENAI_AGENTS_CHAT_API=0 fails at
# startup. Agents with tools, MCP tools or handoffs run in two phases and so
# cost one extra request. The reply is still validated locally against the
# original output_type, and streaming typed output is not supported.
#
# Endpoint-specific: on the endpoint where these modes were measured (one LKEAP
# Token Plan relay), deepseek_json passed for plain and for tool-bearing
# agents, but minimax_function was verified for plain typed agents only - its
# tool-bearing two-phase path succeeded in 3 of 5 runs, so do not rely on it.
# That may be a relay characteristic rather than a MiniMax one; not fixed here.
#
# Optional: token budget for deepseek_json, used when the example sets no
# max_tokens of its own. DeepSeek's JSON mode can truncate or return empty
# content without one.
#AGENT_STRUCTURED_OUTPUT_MAX_TOKENS=2048

# Models not accessible with the configured provider API key, excluded from
# batch_test_models.py. Update this list to match your key's permissions.
BATCH_TEST_EXCLUDED_MODELS=kimi-k-2-5,kimi-k2.5,minimax-m-2-5,minimax-m2.5

# Optional: ask each model to self-report its identity during batch testing.
# This adds one billable request per model; the reported name is unverified.
#BATCH_TEST_REPORT_MODEL_NAME=1
